{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doremy-float-phone222",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "vars": {
    "ALLOWED_ORIGINS": "*",
    "ALLOWED_MEDIA_HOSTS": "REPLACE_WITH_YOUR_AUDIO_HOST"
  }
}
